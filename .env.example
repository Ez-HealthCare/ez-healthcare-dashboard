# Copy to .env. Frontend uses port 3001 in package.json; API uses port 3000.
API_URL=http://localhost:3000/api
APP_ORIGIN=http://localhost:3001

# Isolated local Docker auth database; not the API repo's separate local database.
# Existing database volumes require their original username/password/database.
AUTH_DB_USERNAME=ez_auth
AUTH_DB_PASSWORD=replace-with-a-local-test-database-password
AUTH_DB_DATABASE=ez_auth_test
AUTH_JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_SIGNATURE_SECRET=replace-with-a-random-prescription-signing-secret
