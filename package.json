{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:unit": "node --import ./tests/register-next-aliases.mjs --test tests/http-client.test.mjs tests/auth-services.test.mjs tests/api-boundaries.test.mjs tests/constants.test.mjs tests/workspace-policy.test.mjs",
    "test:workspaces": "node --test tests/workspaces-flow.test.mjs",
    "test:auth": "node --env-file=.env --test tests/auth-flow.test.mjs",
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.6",
    "axios": "1.20.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
